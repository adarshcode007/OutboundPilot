# ==============================================================================
# OutboundSDR Production Environment Configuration
# Copy this file to .env and fill in your actual production values.
# ==============================================================================

# 1. LLM API (Groq Cloud) - https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 2. Database (PostgreSQL) - Neon, Supabase, Render, Railway, or local Docker
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/postgres
PG_POOL_MAX_SIZE=12
DAILY_QUOTA_LIMIT=10

# 3. Security & Authentication
# Generate a secure 64-char secret: openssl rand -hex 32
JWT_SECRET=generate_a_random_64_character_secret_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# 4. CORS Origins (Comma-separated list of allowed production domains)
CORS_ORIGINS=https://your-domain.onrender.com,http://localhost:5173

# 5. Live Web Intelligence (Tier 0 Authenticated Search - Immune to datacenter IP blocks)
# Free 1,000 searches/mo: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_key_here
# Alternative Google Search API: https://serper.dev
SERPER_API_KEY=

# 6. Outbound Email Delivery (SMTP or Resend API)
FROM_EMAIL=outbound@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
# Or Resend API Key:
RESEND_API_KEY=

# 7. Background Autonomous Cron & Scheduler
CRON_DRIP_TIME=08:00
DRIP_RATE_LIMIT_DELAY=5.0

# 8. Real-Time Slack Alerts (Optional webhook)
SLACK_WEBHOOK_URL=
