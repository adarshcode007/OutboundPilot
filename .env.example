# Groq Cloud API Key (Get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Configuration
# Primary target from blueprint: openai/gpt-oss-20b
# Recommended Groq alternatives if needed: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-20b

# Optional: LangSmith Observability (Milestone 8)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-outbound-sdr
